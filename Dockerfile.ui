ARG NODE_VERSION=22
FROM node:${NODE_VERSION}-alpine AS build

ARG NPM_VERSION=11.11.0

# Apply the latest Alpine security patches (musl, zlib, openssl, busybox, ...)
# so the build stage doesn't carry forward outdated apk package revisions.
RUN apk update && apk upgrade --no-cache \
    && rm -rf /var/cache/apk/*

WORKDIR /app

# Install specific NPM version via curl/npm before installing dependencies
# --ignore-scripts: SDOL-025 supply chain safeguard — prevents execution of
# pre/postinstall lifecycle hooks from potentially compromised dependencies
RUN npm install -g npm@${NPM_VERSION} --ignore-scripts

# Copy dependency files first to leverage Docker layer caching
COPY package*.json ./

# Use 'npm ci' for faster, more reliable builds in CI/CD environments
# --ignore-scripts: SDOL-025 supply chain safeguard — prevents execution of
# pre/postinstall lifecycle hooks from potentially compromised dependencies
RUN npm ci --ignore-scripts

# Copy the rest of the source code
COPY . .

# Generate the static assets (dist folder)
RUN npm run build

# Remove development dependencies to keep the build stage clean
RUN npm prune --production

# Stage 2: Production environment
# Base image pulled from the nginx crimson-prod JFrog Artifactory registry
FROM nginx:1.31.7-alpine3.24-slim AS production

# Apply the latest Alpine security patches in the final image as well.
RUN apk update && apk upgrade --no-cache \
    && rm -rf /var/cache/apk/*

# Clean default static files
RUN rm -rf /usr/share/nginx/html/*

# Copy only the compiled assets from the build stage
# Note: Ensure your framework outputs to /app/dist (standard for Vite/Vue/React)
COPY --from=build /app/dist /usr/share/nginx/html

# Update Nginx to listen on 8080 (standard for non-root/containerized environments)
RUN sed -i 's/listen\s\+80;/listen 8080;/' /etc/nginx/conf.d/default.conf

# Expose the new port
EXPOSE 8080