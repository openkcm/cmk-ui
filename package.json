{
  "name": "kms",
  "private": true,
  "version": "1.0.0",
  "author": "SAP SE",
  "description": "KMS UI",
  "dependencies": {
    "@openui5/types": "^1.129.0",
    "@types/axios": "^0.14.4",
    "@types/qunit": "^2.19.11",
    "@ui5/cli": "^4",
    "@ui5/linter": "^1.0.2",
    "@ui5/middleware-code-coverage": "^2.0.1",
    "axios": "^1.7.7",
    "chance": "^1.1.12",
    "cors": "^2.8.5",
    "eslint": "^9.15.0",
    "express": "^4.21.1",
    "http-server": "^14.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "ui5-middleware-livereload": "^3.1.0",
    "ui5-tooling-modules": "^3.17.0",
    "ui5-tooling-stringreplace": "^3.3.0",
    "ui5-tooling-transpile": "^3.5.0",
    "babel-plugin-istanbul": "^7.0.0",
    "ui5-test-runner": "^5.4.3"
  },
  "scripts": {
    "start:mock": "UI5_ENV=mock ui5 serve -o index.html",
    "start:dev": "UI5_ENV=dev ui5 serve -o index.html",
    "start:staging": "UI5_ENV=staging ui5 serve -o index.html",
    "start:prod": "UI5_ENV=prod ui5 serve -o index.html",
    "start:test": "ui5 serve --port 8000",
    "build:mock": "UI5_ENV=mock ui5 build --all",
    "build:dev": "UI5_ENV=dev ui5 build --all",
    "build:staging": "UI5_ENV=staging ui5 build --all",
    "build:prod": "UI5_ENV=prod ui5 build --all",
    "lint-no-fix": "npx eslint --quiet \"./webapp/**/*.ts\"",
    "lint": "npx eslint --fix \"./webapp/**/*.ts\"",
    "serve": "node mock.mjs",
    "start:webserver": "npx http-server dist/ -p 80",
    "test": "npx ui5-test-runner"
  }
}