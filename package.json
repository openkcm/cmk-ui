{
  "name": "kms",
  "private": true,
  "version": "1.0.2",
  "author": "SAP SE",
  "description": "KMS UI",
  "dependencies": {
    "@openui5/types": "^1.129.0",
    "@types/axios": "^0.14.4",
    "@ui5/cli": "^4",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "http-server": "^14.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "ui5-middleware-livereload": "^3.1.0",
    "ui5-tooling-modules": "^3.17.0",
    "ui5-tooling-stringreplace": "^3.3.0",
    "ui5-tooling-transpile": "^3.5.0"
  },
  "scripts": {
    "start": "ui5 serve --port 8081",
    "openchrome": "open -na \"Google Chrome\" \"http://localhost:8081/index.html\" --args --disable-web-security --no-default-browser-check --user-data-dir=\"/tmp/chrome-dev\"",
    "start:test": "ui5 serve --port 8000",
    "build": "npx @ui5/ts-interface-generator && ui5 build --all",
    "lint-no-fix": "npx eslint --quiet \"./webapp/**/*.ts\"",
    "check-types": "tsc --noemit",
    "lint": "npx eslint --fix \"./webapp/**/*.ts\" && npm run check-types",
    "serve": "node mock.mjs",
    "start:webserver": "npx http-server dist/ -p 80",
    "test": "npx ui5-test-runner",
    "playwright": "npx playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.13",
    "@types/qunit": "^2.19.11",
    "@ui5/linter": "^1.0.2",
    "@ui5/middleware-code-coverage": "^2.0.1",
    "@ui5/ts-interface-generator": "^0.10.2",
    "babel-plugin-istanbul": "^7.0.0",
    "chance": "^1.1.12",
    "dotenv": "^10.0.0",
    "eslint": "^9.15.0",
    "express": "^4.21.1",
    "typescript-eslint": "^8.15.0",
    "ui5-test-runner": "^5.4.3"
  }
}