<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f">
    <f:GridContainer class="sapUiSmallMargin" items="{oneWay>/configs}">
        <f:layout>
            <f:GridContainerSettings rowSize="84px" columnSize="84px" gap="8px" />
        </f:layout>
        <f:GridListItem press="onConfigPress"
            type="Active">
            <f:layoutData>
                <f:GridContainerItemLayoutData columns="4" />
            </f:layoutData>
            <VBox
                width="100%"
                class="sapUiContentPadding"
                justifyContent="SpaceBetween">
                <VBox justifyContent="SpaceBetween"
                    class="sapUiSmallMarginBegin sapUiSmallMarginTop sapUiSmallMarginEnd"
                    width="100%">
                    <Title text="{oneWay>name}" />
                    <Label text="{oneWay>id}" />
                </VBox>
                <HBox justifyContent="SpaceBetween"
                    class="sapUiSmallMarginBegin sapUiSmallMarginTop sapUiSmallMarginEnd"
                    width="100%">
                    <VBox width="50%">
                        <Label text="{i18n>keys}:" />
                        <Text text="{oneWay>metadata/totalKeys}" />
                    </VBox>
                    <VBox width="50%">
                        <Label text="Systems:" />
                        <Text text="{oneWay>metadata/totalSystems}" />
                    </VBox>
                </HBox>
                <VBox justifyContent="SpaceBetween"
                    backgroundDesign="Solid"
                    height="110px"
                    visible="{= !!${oneWay>primaryKey}}"
                    class="gray-background-color rounded-box sapUiSmallMargin">
                    <Title text="{i18n>primaryKey}:" titleStyle="H6"
                        class="sapUiTinyMarginBegin sapUiTinyMarginTop" />
                    <Label design="Bold" text="{oneWay>primaryKey/name}"
                        class="sapUiTinyMarginBegin" />
                    <Label text="{oneWay>primaryKey/provider} • {oneWay>primaryKey/region}"
                        class="sapUiTinyMarginBegin" />
                    <ObjectStatus
                        visible="{= ${oneWay>primaryKey/state} === 'ENABLED'}"
                        icon="sap-icon://sys-enter-2"
                        text="{i18n>active}"
                        class="sapUiTinyMargin"
                        inverted="true"
                        state="Indication14" />
                    <ObjectStatus
                        visible="{= ${oneWay>primaryKey/state} === 'DISABLED'}"
                        icon="sap-icon://warning"
                        text="{i18n>disabled}"
                        class="sapUiTinyMargin"
                        inverted="true"
                        state="Indication13" />
                </VBox>
                <HBox justifyContent="Center" alignItems="Center"
                    backgroundDesign="Solid"
                    visible="{= !${oneWay>primaryKey}}"
                    height="110px"
                    class="outlined-dotted-box-rounded-corners sapUiSmallMargin">
                    <MenuButton text="{i18n>addKey}" icon="sap-icon://add">
                        <menu>
                            <Menu class="sapUiSizeCompact">
                                <MenuItem text="{i18n>sapManaged}"
                                    press=".onKeyConfigDashboardCreateSAPKeyPress($event, 'SYSTEM_MANAGED')" />
                                <MenuItem text="{i18n>hyok}">
                                    <items>
                                        <MenuItemGroup
                                            items="{oneWay>/hyokProviders}"
                                            itemSelectionMode="None">
                                            <items>
                                                <MenuItem text="{oneWay>}"
                                                    press=".onKeyConfigDashboardCreateSAPKeyPress($event, 'HYOK', ${oneWay>})" />
                                            </items>
                                        </MenuItemGroup>
                                    </items>
                                </MenuItem>
                            </Menu>
                        </menu>
                    </MenuButton>
                </HBox>
            </VBox>
        </f:GridListItem>
    </f:GridContainer>
</core:FragmentDefinition>