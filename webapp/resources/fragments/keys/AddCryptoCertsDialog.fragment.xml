<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    core:require="{commonFormatter: 'kms/common/Formatters' }">
    <Dialog
        id="addCryptoCertsDialog"
        title="{i18n>addCryptoCertsTitle}"
        contentWidth="36rem"
        escapeHandler=".onCancelAddCryptoCerts">
        <content>
            <VBox class="sapUiSmallMargin">
                <MessageStrip
                    id="allCertsAssignedStrip"
                    text="{i18n>allCryptoCertsAssigned}"
                    type="Information"
                    showIcon="true"
                    visible="{addCryptoCertsModel>/allCertsAssigned}"
                    class="sapUiSmallMarginBottom"/>
                <VBox visible="{= !${addCryptoCertsModel>/allCertsAssigned}}">
                    <Text text="{i18n>selectCryptoCert}" class="sapUiSmallMarginBottom" />
                    <VBox items="{addCryptoCertsModel>/newCryptoCertEntries}"
                        class="sapUiSmallMarginBottom">
                        <VBox class="sapUiSmallMarginBottom">
                            <HBox alignItems="Center">
                                <VBox width="100%">
                                    <VBox width="100%" items="{addCryptoCertsModel>selectedCerts}"
                                        class="sapUiSmallMarginBottom">
                                        <VBox class="sapUiTinyMarginBottom">
                                            <Label text="{i18n>name}:" />
                                            <Text text="{addCryptoCertsModel>name}" wrapping="true" />
                                            <Label text="{i18n>rootCALabel}:"
                                                class="sapUiTinyMarginTop" />
                                            <HBox alignItems="Center">
                                                <Text text="{addCryptoCertsModel>rootCA}"
                                                    wrapping="true"
                                                    class="sapUiSmallMarginEnd" />
                                                <Button text="{i18n>downloadRootCACert}"
                                                    press="onDownloadRootCA"
                                                    enabled="{= !!${addCryptoCertsModel>rootCA}}" />
                                            </HBox>
                                            <Label text="{i18n>subject}:" class="sapUiTinyMarginTop" />
                                            <Text text="{path: 'addCryptoCertsModel>subject', formatter: 'commonFormatter.formatSubjectDN'}"
                                                wrapping="true" />
                                            <HBox class="sapUiSmallMarginTop" wrap="Wrap">
                                                <VBox class="sapUiMediumMarginEnd sapUiTinyMarginBottom">
                                                    <Label text="{i18n>subjectCN}:" />
                                                    <Text text="{path: 'addCryptoCertsModel>subject/CN', formatter: 'commonFormatter.formatSubjectDNField'}" wrapping="true" />
                                                </VBox>
                                                <VBox class="sapUiMediumMarginEnd sapUiTinyMarginBottom">
                                                    <Label text="{i18n>subjectOU}:" />
                                                    <Text text="{path: 'addCryptoCertsModel>subject/OU', formatter: 'commonFormatter.formatSubjectDNField'}" wrapping="true" renderWhitespace="true" />
                                                </VBox>
                                                <VBox class="sapUiMediumMarginEnd sapUiTinyMarginBottom">
                                                    <Label text="{i18n>subjectO}:" />
                                                    <Text text="{path: 'addCryptoCertsModel>subject/O', formatter: 'commonFormatter.formatSubjectDNField'}" wrapping="true" />
                                                </VBox>
                                                <VBox class="sapUiMediumMarginEnd sapUiTinyMarginBottom">
                                                    <Label text="{i18n>subjectL}:" />
                                                    <Text text="{path: 'addCryptoCertsModel>subject/L', formatter: 'commonFormatter.formatSubjectDNField'}" wrapping="true" />
                                                </VBox>
                                                <VBox class="sapUiMediumMarginEnd sapUiTinyMarginBottom">
                                                    <Label text="{i18n>subjectC}:" />
                                                    <Text text="{path: 'addCryptoCertsModel>subject/C', formatter: 'commonFormatter.formatSubjectDNField'}" wrapping="true" />
                                                </VBox>
                                            </HBox>
                                        </VBox>
                                    </VBox>
                                    <VBox visible="{= ${addCryptoCertsModel>/provider} === 'AWS'}">
                                        <Label text="{i18n>trustAnchorARN}:" class="sapUiTinyMarginTop"
                                               required="true" />
                                        <Input value="{addCryptoCertsModel>trustAnchorArn}"
                                               valueLiveUpdate="true"
                                               liveChange=".onAddCryptoCertLiveChange"/>
                                        <Label text="{i18n>roleARN}:" class="sapUiTinyMarginTop"
                                               required="true" />
                                        <Input value="{addCryptoCertsModel>roleArn}"
                                               valueLiveUpdate="true"
                                               liveChange=".onAddCryptoCertLiveChange"/>
                                        <Label text="{i18n>profileARN}:" class="sapUiTinyMarginTop"
                                               required="true" />
                                        <Input value="{addCryptoCertsModel>profileArn}"
                                               valueLiveUpdate="true"
                                               liveChange=".onAddCryptoCertLiveChange"/>
                                    </VBox>
                                    <VBox visible="{= ${addCryptoCertsModel>/provider} === 'FORTANIX'}">
                                        <Label text="{i18n>applicationId}:" class="sapUiTinyMarginTop"
                                               required="true" />
                                        <Input value="{addCryptoCertsModel>applicationId}"
                                               valueLiveUpdate="true"
                                               liveChange=".onAddCryptoCertLiveChange"/>
                                    </VBox>
                                </VBox>
                                <Button icon="sap-icon://decline"
                                        type="Transparent"
                                        press=".onRemoveNewCryptoCertEntry"
                                        class="sapUiSmallMarginBegin"/>
                            </HBox>
                        </VBox>
                    </VBox>
                    <VBox visible="{addCryptoCertsModel>/canAddMore}">
                        <HBox width="100%" alignItems="Center" class="sapUiSmallMarginTop">
                            <MultiComboBox
                                id="addCryptoCertsMultiComboBox"
                                items="{
                                    path: 'addCryptoCertsModel>/availableCerts'
                                }"
                                selectedKeys="{addCryptoCertsModel>/selectedCertKeys}"
                                showSelectAll="false"
                                selectionFinish=".onAddCryptoCertSelectionFinish"
                                width="100%"
                                placeholder="{i18n>selectCryptoCert}">
                                <core:Item
                                    key="{addCryptoCertsModel>name}"
                                    text="{addCryptoCertsModel>name}"/>
                            </MultiComboBox>
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>
        </content>
        <beginButton>
            <Button
                text="{i18n>save}"
                type="Emphasized"
                press=".onSaveAddCryptoCerts"
                enabled="{addCryptoCertsModel>/saveEnabled}"/>
        </beginButton>
        <endButton>
            <Button
                text="{i18n>cancel}"
                type="Transparent"
                press=".onCancelAddCryptoCerts"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>