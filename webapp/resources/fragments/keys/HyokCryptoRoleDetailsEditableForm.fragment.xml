<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:forms="sap.ui.layout.form"
    core:require="{ commonFormatter: 'kms/common/Formatters' }">
    <VBox>
        <VBox class="sapUiSmallMarginBegin sapUiSmallMarginTop">
            <Label text="{i18n>certificateSubject}" design="Bold" />
            <SegmentedButton
                selectedKey="{twoWay>certViewMode}"
                selectionChange="onToggleCertViewMode"
                class="sapUiTinyMarginTop sapUiTinyMarginBottom"
                width="12rem">
                <items>
                    <SegmentedButtonItem key="String" text="{i18n>certViewString}" />
                    <SegmentedButtonItem key="Details" text="{i18n>certViewDetails}"
                        visible="{path: 'twoWay>subject', formatter: 'commonFormatter.hasStructuredSubject'}" />
                </items>
            </SegmentedButton>
            <Text text="{path: 'twoWay>subject', formatter: 'commonFormatter.formatSubjectDN'}"
                wrapping="true"
                visible="{= ${twoWay>certViewMode} !== 'Details' }" />
            <HBox class="sapUiTinyMarginTop" wrap="Wrap"
                visible="{= ${twoWay>certViewMode} === 'Details' }">
                <VBox class="sapUiMediumMarginEnd sapUiTinyMarginBottom">
                    <Label text="{i18n>subjectCN}:" />
                    <Text text="{path: 'twoWay>subject/CN', formatter: 'commonFormatter.formatSubjectDNField'}" wrapping="true" />
                </VBox>
                <VBox class="sapUiMediumMarginEnd sapUiTinyMarginBottom">
                    <Label text="{path: 'twoWay>subject/OU', formatter: 'commonFormatter.formatSubjectOULabel'}" />
                    <Text text="{path: 'twoWay>subject/OU', formatter: 'commonFormatter.formatSubjectDNField'}" wrapping="true" renderWhitespace="true" />
                </VBox>
                <VBox class="sapUiMediumMarginEnd sapUiTinyMarginBottom">
                    <Label text="{i18n>subjectO}:" />
                    <Text text="{path: 'twoWay>subject/O', formatter: 'commonFormatter.formatSubjectDNField'}" wrapping="true" />
                </VBox>
                <VBox class="sapUiMediumMarginEnd sapUiTinyMarginBottom">
                    <Label text="{i18n>subjectL}:" />
                    <Text text="{path: 'twoWay>subject/L', formatter: 'commonFormatter.formatSubjectDNField'}" wrapping="true" />
                </VBox>
                <VBox class="sapUiMediumMarginEnd sapUiTinyMarginBottom">
                    <Label text="{i18n>subjectC}:" />
                    <Text text="{path: 'twoWay>subject/C', formatter: 'commonFormatter.formatSubjectDNField'}" wrapping="true" />
                </VBox>
            </HBox>
        </VBox>
        <forms:Form width="100%" visible="{= !!${twoWay>value/isEditable} }">
            <forms:layout>
                <forms:ColumnLayout
                    columnsM="1"
                    columnsL="1"
                    columnsXL="1" />
            </forms:layout>
            <forms:toolbar>
                <OverflowToolbar>
                    <Title text="{i18n>cryptoRole}: {twoWay>key}" />
                </OverflowToolbar>
            </forms:toolbar>
            <forms:formContainers>
                <forms:FormContainer visible="{= ${oneWay>/selectedKey/provider} === 'AWS'}">
                    <forms:formElements>
                        <forms:FormElement label="{i18n>trustAnchorARN}">
                            <forms:fields>
                                <Input value="{twoWay>value/trustAnchorArn}" />
                            </forms:fields>
                        </forms:FormElement>
                        <forms:FormElement label="{i18n>roleARN}">
                            <forms:fields>
                                <Input value="{twoWay>value/roleArn}" />
                            </forms:fields>
                        </forms:FormElement>
                        <forms:FormElement label="{i18n>profileARN}">
                            <forms:fields>
                                <Input value="{twoWay>value/profileArn}" />
                            </forms:fields>
                        </forms:FormElement>
                    </forms:formElements>
                </forms:FormContainer>
                <forms:FormContainer visible="{= ${oneWay>/selectedKey/provider} === 'FORTANIX'}">
                    <forms:formElements>
                        <forms:FormElement label="{i18n>applicationId}">
                            <forms:fields>
                                <Input value="{twoWay>value/applicationId}" />
                            </forms:fields>
                        </forms:FormElement>
                    </forms:formElements>
                </forms:FormContainer>
                <forms:FormContainer visible="{= ${oneWay>/selectedKey/provider} === 'GCP'}">
                    <forms:formElements>
                        <forms:FormElement label="{i18n>projectNumber}">
                            <forms:fields>
                                <Input value="{twoWay>value/projectNumber}" />
                            </forms:fields>
                        </forms:FormElement>
                        <forms:FormElement label="{i18n>poolId}">
                            <forms:fields>
                                <Input value="{twoWay>value/poolId}" />
                            </forms:fields>
                        </forms:FormElement>
                        <forms:FormElement label="{i18n>providerId}">
                            <forms:fields>
                                <Input value="{twoWay>value/providerId}" />
                            </forms:fields>
                        </forms:FormElement>
                        <forms:FormElement label="{i18n>serviceAccount}">
                            <forms:fields>
                                <Input value="{twoWay>value/serviceAccount}" />
                            </forms:fields>
                        </forms:FormElement>
                    </forms:formElements>
                </forms:FormContainer>
            </forms:formContainers>
        </forms:Form>
        <forms:Form width="100%" visible="{= !${twoWay>value/isEditable} }">
            <forms:layout>
                <forms:ColumnLayout
                    columnsM="1"
                    columnsL="1"
                    columnsXL="1" />
            </forms:layout>
            <forms:toolbar>
                <OverflowToolbar>
                    <Title text="{i18n>cryptoRole}: {twoWay>key}" />
                </OverflowToolbar>
            </forms:toolbar>
            <forms:formContainers>
                <forms:FormContainer visible="{= ${oneWay>/selectedKey/provider} === 'AWS'}">
                    <forms:formElements>
                        <forms:FormElement label="{i18n>trustAnchorARN}">
                            <forms:fields>
                                <Text text="{twoWay>value/trustAnchorArn}" wrapping="true" />
                            </forms:fields>
                        </forms:FormElement>
                        <forms:FormElement label="{i18n>roleARN}">
                            <forms:fields>
                                <Text text="{twoWay>value/roleArn}" wrapping="true" />
                            </forms:fields>
                        </forms:FormElement>
                        <forms:FormElement label="{i18n>profileARN}">
                            <forms:fields>
                                <Text text="{twoWay>value/profileArn}" wrapping="true" />
                            </forms:fields>
                        </forms:FormElement>
                    </forms:formElements>
                </forms:FormContainer>
                <forms:FormContainer visible="{= ${oneWay>/selectedKey/provider} === 'FORTANIX'}">
                    <forms:formElements>
                        <forms:FormElement label="{i18n>applicationId}">
                            <forms:fields>
                                <Text text="{twoWay>value/applicationId}" wrapping="true" />
                            </forms:fields>
                        </forms:FormElement>
                    </forms:formElements>
                </forms:FormContainer>
                <forms:FormContainer visible="{= ${oneWay>/selectedKey/provider} === 'GCP'}">
                    <forms:formElements>
                        <forms:FormElement label="{i18n>projectNumber}">
                            <forms:fields>
                                <Text text="{twoWay>value/projectNumber}" wrapping="true" />
                            </forms:fields>
                        </forms:FormElement>
                        <forms:FormElement label="{i18n>poolId}">
                            <forms:fields>
                                <Text text="{twoWay>value/poolId}" wrapping="true" />
                            </forms:fields>
                        </forms:FormElement>
                        <forms:FormElement label="{i18n>providerId}">
                            <forms:fields>
                                <Text text="{twoWay>value/providerId}" wrapping="true" />
                            </forms:fields>
                        </forms:FormElement>
                        <forms:FormElement label="{i18n>serviceAccount}">
                            <forms:fields>
                                <Text text="{twoWay>value/serviceAccount}" wrapping="true" />
                            </forms:fields>
                        </forms:FormElement>
                    </forms:formElements>
                </forms:FormContainer>
            </forms:formContainers>
        </forms:Form>
    </VBox>
</core:FragmentDefinition>