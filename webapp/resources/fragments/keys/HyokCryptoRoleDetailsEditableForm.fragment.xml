<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:forms="sap.ui.layout.form">
    <VBox>
        <forms:Form width="100%" visible="{= !!${twoWay>value/isEditable} }">
            <forms:layout>
                <forms:ColumnLayout
                    columnsM="1"
                    columnsL="1"
                    columnsXL="1" />
            </forms:layout>
            <forms:toolbar>
                <OverflowToolbar>
                    <Title text="{i18n>cryptoRole}: {twoWay>key}" />
                </OverflowToolbar>
            </forms:toolbar>
            <forms:formContainers>
                <forms:FormContainer visible="{= ${oneWay>/selectedKey/provider} === 'AWS'}">
                    <forms:formElements>
                        <forms:FormElement label="{i18n>trustAnchorARN}">
                            <forms:fields>
                                <Input value="{twoWay>value/trustAnchorArn}" />
                            </forms:fields>
                        </forms:FormElement>
                        <forms:FormElement label="{i18n>roleARN}">
                            <forms:fields>
                                <Input value="{twoWay>value/roleArn}" />
                            </forms:fields>
                        </forms:FormElement>
                        <forms:FormElement label="{i18n>profileARN}">
                            <forms:fields>
                                <Input value="{twoWay>value/profileArn}" />
                            </forms:fields>
                        </forms:FormElement>
                    </forms:formElements>
                </forms:FormContainer>
                <forms:FormContainer visible="{= ${oneWay>/selectedKey/provider} === 'FORTANIX'}">
                    <forms:formElements>
                        <forms:FormElement label="{i18n>applicationId}">
                            <forms:fields>
                                <Input value="{twoWay>value/applicationId}" />
                            </forms:fields>
                        </forms:FormElement>
                    </forms:formElements>
                </forms:FormContainer>
            </forms:formContainers>
        </forms:Form>
        <forms:Form width="100%" visible="{= !${twoWay>value/isEditable} }">
            <forms:layout>
                <forms:ColumnLayout
                    columnsM="1"
                    columnsL="1"
                    columnsXL="1" />
            </forms:layout>
            <forms:toolbar>
                <OverflowToolbar>
                    <Title text="{i18n>cryptoRole}: {twoWay>key}" />
                </OverflowToolbar>
            </forms:toolbar>
            <forms:formContainers>
                <forms:FormContainer visible="{= ${oneWay>/selectedKey/provider} === 'AWS'}">
                    <forms:formElements>
                        <forms:FormElement label="{i18n>trustAnchorARN}">
                            <forms:fields>
                                <Text text="{twoWay>value/trustAnchorArn}" wrapping="true" />
                            </forms:fields>
                        </forms:FormElement>
                        <forms:FormElement label="{i18n>roleARN}">
                            <forms:fields>
                                <Text text="{twoWay>value/roleArn}" wrapping="true" />
                            </forms:fields>
                        </forms:FormElement>
                        <forms:FormElement label="{i18n>profileARN}">
                            <forms:fields>
                                <Text text="{twoWay>value/profileArn}" wrapping="true" />
                            </forms:fields>
                        </forms:FormElement>
                    </forms:formElements>
                </forms:FormContainer>
                <forms:FormContainer visible="{= ${oneWay>/selectedKey/provider} === 'FORTANIX'}">
                    <forms:formElements>
                        <forms:FormElement label="{i18n>applicationId}">
                            <forms:fields>
                                <Text text="{twoWay>value/applicationId}" wrapping="true" />
                            </forms:fields>
                        </forms:FormElement>
                    </forms:formElements>
                </forms:FormContainer>
            </forms:formContainers>
        </forms:Form>
    </VBox>
</core:FragmentDefinition>