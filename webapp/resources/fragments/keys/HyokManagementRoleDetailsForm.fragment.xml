<core:FragmentDefinition xmlns="sap.m"
                         xmlns:core="sap.ui.core"
                         xmlns:forms="sap.ui.layout.form"
                         core:require="{ commonFormatter: 'kms/common/Formatters' }">
    <forms:Form width="100%">
        <forms:layout>
            <forms:ColumnLayout
                    columnsM="1"
                    columnsL="1"
                    columnsXL="1" />
        </forms:layout>
        <forms:toolbar>
            <OverflowToolbar>
                <Title text="{i18n>managementRole}" />
            </OverflowToolbar>
        </forms:toolbar>
        <forms:formContainers>
            <forms:FormContainer>
                <forms:formElements>
                    <forms:FormElement label="{i18n>trustAnchorARN}" visible="{parts: ['oneWay>/selectedKey/provider'], formatter: 'commonFormatter.displayAWSField'}">
                        <forms:fields>
                            <Text text="{twoWay>value/trustAnchorArn}" wrapping="true"/>
                        </forms:fields>
                    </forms:FormElement>
                    <forms:FormElement label="{i18n>roleARN}" visible="{parts: ['oneWay>/selectedKey/provider'], formatter: 'commonFormatter.displayAWSField'}">
                        <forms:fields>
                            <Text text="{twoWay>value/roleArn}" wrapping="true"/>
                        </forms:fields>
                    </forms:FormElement>
                    <forms:FormElement label="{i18n>profileARN}" visible="{parts: ['oneWay>/selectedKey/provider'], formatter: 'commonFormatter.displayAWSField'}">
                        <forms:fields>
                            <Text text="{twoWay>value/profileArn}" wrapping="true"/>
                        </forms:fields>
                    </forms:FormElement>
                    <forms:FormElement label="{i18n>applicationId}" visible="{parts: ['oneWay>/selectedKey/provider'], formatter: 'commonFormatter.displayFortanixField'}">
                        <forms:fields>
                            <Text text="{twoWay>value/applicationId}" wrapping="true"/>
                        </forms:fields>
                    </forms:FormElement>
                    <forms:FormElement label="{i18n>host}" visible="{parts: ['oneWay>/selectedKey/provider'], formatter: 'commonFormatter.displayFortanixField'}">
                        <forms:fields>
                            <Text text="{twoWay>value/host}" wrapping="true"/>
                        </forms:fields>
                    </forms:FormElement>
                </forms:formElements>
            </forms:FormContainer>
        </forms:formContainers>
    </forms:Form>
</core:FragmentDefinition>