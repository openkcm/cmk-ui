<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:tnt="sap.tnt"
    core:require="{ formatMessage: 'sap/base/strings/formatMessage' }">
    <Table
        noDataText=" "
        items="{
                    path: 'oneWay>/keys',
                    sorter: {
                        path: 'enabled',
                        descending: true
                    }
                }"
        contextualWidth="Auto"
        popinLayout="GridSmall">
        <headerToolbar>
            <OverflowToolbar>
                <Title
                    text="{parts: ['i18n>keysWithCount', 'oneWay>/keysCount'], formatter: 'formatMessage'}"
                    level="H2" />
                <ToolbarSpacer />
                <MenuButton text="{i18n>create}" icon="sap-icon://add" type="Ghost">
                    <menu>
                        <Menu class="sapUiSizeCompact">
                            <MenuItem text="{i18n>sapManaged}"
                                press="handleCreateKeyRoute" />
                        </Menu>
                    </menu>
                </MenuButton>
                <Button
                    icon="sap-icon://filter"
                    press="onKeysTableFilterPress"
                    type="Transparent" />
                <Button
                    icon="sap-icon://sort"
                    press="onKeysTableSortPress"
                    class="sapUiSmallMarginEnd"
                    type="Transparent" />
            </OverflowToolbar>
        </headerToolbar>
        <columns>
            <Column
                vAlign="Middle"
                hAlign="Begin"
                width="15rem"
                minScreenWidth="Large"
                demandPopin="false"
                visible="{= ${oneWay>/keys}.length > 0 }">
                <Text text="{i18n>name}" />
            </Column>
            <Column
                vAlign="Middle"
                hAlign="End"
                minScreenWidth="Large"
                demandPopin="true"
                visible="{= ${oneWay>/keys}.length > 0 }">
                <Text text="{i18n>createdOn}" wrapping="false" />
            </Column>
            <Column
                hAlign="End"
                vAlign="Middle"
                minScreenWidth="Large"
                demandPopin="true"
                visible="{= ${oneWay>/keys}.length > 0 }">
                <Text text="{i18n>state}" wrapping="false" />
            </Column>
            <Column
                hAlign="End"
                vAlign="Middle"
                minScreenWidth="Large"
                demandPopin="true"
                visible="{= ${oneWay>/keys}.length > 0 }">
                <Text text="{i18n>actions}" wrapping="false" />
            </Column>
        </columns>
        <items>
            <ColumnListItem vAlign="Middle" type="Navigation" press="onKeyTableRowPress">
                <cells>
                    <VBox justifyContent="Center" alignContent="Center">
                        <HBox alignItems="End" justifyContent="Start">
                            <tnt:InfoLabel
                                icon="sap-icon://favorite"
                                visible="{= !!${oneWay>primary}}"
                                class="sapUiTinyMarginEnd"
                                text="{i18n>primary}"
                                displayOnly="true"
                                colorScheme="5" />
                            <Text text="{oneWay>name}" wrapping="false" />
                        </HBox>
                        <Label text="{oneWay>provider} • {oneWay>region}" />
                    </VBox>
                    <Text
                        text="{path:'oneWay>metadata/createdAt', type:'sap.ui.model.type.DateTime', formatOptions:{UTC: true, pattern: 'MMM dd yyyy', source:{pattern: 'yyyy-MM-ddTHH:mm:ss.SSSSSSZ'}}}"
                        wrapping="false" />
                    <VBox justifyContent="Center">
                        <tnt:InfoLabel
                            visible="{= !!${oneWay>enabled}}"
                            text="{i18n>enabled}"
                            colorScheme="8" />
                        <tnt:InfoLabel
                            visible="{= !${oneWay>enabled}}"
                            text="{i18n>disabled}"
                            colorScheme="2" />
                    </VBox>
                    <VBox alignContent="End" alignItems="End"
                        justifyContent="End">
                        <MenuButton icon="sap-icon://action-settings" type="Transparent"
                            enabled="{= !${oneWay>enabled}}">
                            <menu>
                                <Menu class="sapUiSizeCompact">
                                    <MenuItem press="onKeyTableMakePrimaryPress"
                                        text="{i18n>makePrimary}"
                                        visible="{= !${oneWay>enabled}}"
                                        icon="sap-icon://favorite" />
                                    <MenuItem press="onKeyTableDeletePress" text="{i18n>delete}"
                                        icon="sap-icon://delete" />
                                </Menu>
                            </menu>
                        </MenuButton>
                    </VBox>
                </cells>
            </ColumnListItem>
        </items>
    </Table>
</core:FragmentDefinition>