<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:tnt="sap.tnt"
    core:require="{ formatMessage: 'sap/base/strings/formatMessage' }">
    <Table
        noDataText=" "
        items="{
                    path: 'oneWay>/keyVersions',
                    sorter: {
                        path: 'metadata/createdAt',
                        descending: true
                    }
                }"
        contextualWidth="Auto"
        popinLayout="GridSmall">
        <headerToolbar>
            <OverflowToolbar>
                <Title
                    text="{parts: ['i18n>versionsWithCount', 'oneWay>/keyVersionsCount'], formatter: 'formatMessage'}"
                    level="H2" />
                <ToolbarSpacer />
                <MenuButton text="{i18n>rotate}" icon="sap-icon://synchronize" type="Ghost"
                    visible="{= ${oneWay>/selectedKey/type} !== 'HYOK'}">
                    <menu>
                        <Menu class="sapUiSizeCompact">
                            <MenuItem text="{i18n>rotateNow}"
                                press="onRotateNowPress">
                                <customData>
                                    <core:CustomData
                                        key="testId"
                                        value="versionsTable-rotateNowButton"
                                        writeToDom="true" />
                                </customData>
                            </MenuItem>
                            <MenuItem text="{i18n>confgureRotation}" enabled="false"
                                press="onConfigureRotationPress">
                                <customData>
                                    <core:CustomData
                                        key="testId"
                                        value="versionsTable-configureRotationButton"
                                        writeToDom="true" />
                                </customData>
                            </MenuItem>
                        </Menu>
                    </menu>
                    <customData>
                        <core:CustomData
                            key="testId"
                            value="versionsTable-rotateButton"
                            writeToDom="true" />
                    </customData>
                </MenuButton>
            </OverflowToolbar>
        </headerToolbar>
        <columns>

            <Column
                vAlign="Middle"
                hAlign="Begin"
                minScreenWidth="XSmall"
                demandPopin="true">
                <Text text="" />
            </Column>
            <Column
                vAlign="Middle"
                hAlign="Begin"
                minScreenWidth="XSmall"
                width="8rem"
                demandPopin="false">
                <Text text="{i18n>nativeIdentifier}" />
            </Column>
            <Column
                vAlign="Middle"
                hAlign="Begin"
                minScreenWidth="XSmall"
                demandPopin="true"
                width="8rem">
                <Text text="{i18n>state}" />
            </Column>
            <Column
                vAlign="Middle"
                hAlign="Begin"
                minScreenWidth="Small"
                demandPopin="true">
                <Text text="{i18n>rotationTime}" wrapping="true" />
            </Column>
            <Column
                vAlign="Middle"
                hAlign="Begin"
                minScreenWidth="Small"
                demandPopin="true">
                <Text text="{i18n>createdOn}" wrapping="true" />
            </Column>
        </columns>
        <items>
            <ColumnListItem vAlign="Middle" type="Inactive">
                <cells>
                    <tnt:InfoLabel
                    icon="sap-icon://favorite"
                    visible="{= !!${oneWay>isPrimary}}"
                    text="{i18n>active}"
                    displayOnly="true"
                    colorScheme="5"
                    data:testId="versionsTable-activeMarker"
                    xmlns:data="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1" />
                    <Text
                        text="{oneWay>nativeID}"
                        data:testId="versionsTable-nativeIdText"
                        xmlns:data="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1" />
                    <VBox justifyContent="Center">
                        <tnt:InfoLabel
                            visible="{= ${oneWay>state} === 'ENABLED'}"
                            text="{i18n>enabled}"
                            colorScheme="8" />
                        <tnt:InfoLabel
                            visible="{= ${oneWay>state} === 'DISABLED'}"
                            text="{i18n>disabled}"
                            colorScheme="2" />
                    </VBox>
                    <Text
                        text="{path:'oneWay>metadata/rotatedAt', type:'sap.ui.model.type.DateTime', formatOptions:{UTC: true, source:{pattern: 'yyyy-MM-dd\'T\'HH:mm:ss.SSSSSSX'}}} UTC"
                        wrapping="true">
                        <customData>
                            <core:CustomData
                                key="testId"
                                value="versionsTable-rotationTimeText"
                                writeToDom="true" />
                        </customData>
                    </Text>
                    <Text
                        text="{path:'oneWay>metadata/createdAt', type:'sap.ui.model.type.DateTime', formatOptions:{UTC: true, source:{pattern: 'yyyy-MM-dd\'T\'HH:mm:ss.SSSSSSX'}}} UTC"
                        wrapping="true">
                        <customData>
                            <core:CustomData
                                key="testId"
                                value="versionsTable-createdOnText"
                                writeToDom="true" />
                        </customData>
                    </Text>
                </cells>
            </ColumnListItem>
        </items>
    </Table>
</core:FragmentDefinition>