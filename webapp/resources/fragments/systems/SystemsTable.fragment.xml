<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:tnt="sap.tnt"
    core:require="{ formatMessage: 'sap/base/strings/formatMessage' }">
    <Table
        id="systemsTable"
        inset="false"
        items="{oneWay>/systems}">
        <headerToolbar>
            <OverflowToolbar>
                <Title
                    text="{parts: ['i18n>systemsCount', 'oneWay>/systemsCount'], formatter: 'formatMessage'}"
                    level="H2" />
                <ToolbarSpacer />
                <Button text="{i18n>connect}" icon="sap-icon://add" type="Ghost"
                    press="onConnectSystemPress" visible="{= !!${oneWay>/keyConfigDetail}}"></Button>
                <Button
                    icon="sap-icon://filter"
                    press="onKeysTableFilterPress"
                    type="Transparent" />
                <Button
                    icon="sap-icon://sort"
                    press="onKeysTableSortPress"
                    class="sapUiSmallMarginEnd"
                    type="Transparent" />
            </OverflowToolbar>
        </headerToolbar>
        <columns>
            <Column minScreenWidth="Tablet" demandPopin="true">
                <Text text="{i18n>name}" />
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true">
                <Text text="{i18n>identifier}" />
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true">
                <Text text="{i18n>systemsRole}" />
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true"
                visible="{= !${oneWay>/keyConfigDetail}}">
                <Text text="{i18n>keyConfiguration}" />
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true"
                visible="{= !!${oneWay>/keyConfigDetail}}">
                <Text text="{i18n>state}" />
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true"
                visible="{= !!${oneWay>/keyConfigDetail}}" hAlign="End"
                vAlign="Middle">
                <Text text="{i18n>actions}" />
            </Column>
        </columns>

        <items>
            <ColumnListItem vAlign="Middle" type="Navigation" press="onSystemPress">
                <cells>
                    <ObjectIdentifier title="{oneWay>name}" text="{oneWay>region}" />
                    <Text text="{oneWay>id}" />
                    <Text text="{oneWay>systemRole}" />
                    <VBox visible="{= !${oneWay>/keyConfigDetail}}">
                        <ObjectStatus
                            icon="sap-icon://sys-enter-2"
                            text="{i18n>connected}"
                            active="true"
                            press="handleStatusPressed"
                            visible="{= ${oneWay>status} === 'CONNECTED'}"
                            inverted="true"
                            state="Indication14" />
                        <Button text="Connect"
                            press="onTargetConnectSystemPress"
                            visible="{= ${oneWay>status} === 'DISCONNECTED'}"
                            icon="sap-icon://add" />
                    </VBox>
                    <VBox justifyContent="Center">
                        <tnt:InfoLabel
                            visible="{= ${oneWay>status} === 'CONNECTED'}"
                            text="{i18n>connected}"
                            colorScheme="8" />
                        <tnt:InfoLabel
                            visible="{= ${oneWay>status} === 'DISCONNECTED'}"
                            text="{i18n>disconnected}"
                            colorScheme="2" />
                    </VBox>
                    <VBox alignContent="Center"
                        justifyContent="Start">
                        <MenuButton icon="sap-icon://action-settings" type="Transparent">
                            <menu>
                                <Menu class="sapUiSizeCompact">
                                    <MenuItem text="{i18n>switchKeyConfiguration}"
                                        press="onSwitchKeyConfigPress" />
                                    <MenuItem
                                        press="onSystemsTableDisconnectPress"
                                        text="{i18n>disconnect}" />
                                </Menu>
                            </menu>
                        </MenuButton>
                    </VBox>
                </cells>
            </ColumnListItem>
        </items>
    </Table>
</core:FragmentDefinition>