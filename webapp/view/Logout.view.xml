<mvc:View
    controllerName="kms.controller.Logout"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:mvc="sap.ui.core.mvc">
    <f:DynamicPage>
        <f:title>
        </f:title>
        <f:content>
            <VBox alignItems="Center" justifyContent="Center">
                <IllustratedMessage enableVerticalResponsiveness="false"
                    title="{i18n>loggedOutTitle}"
                    description="{i18n>loggedOutMessage}"
                    enableDefaultTitleAndDescription="false"
                    illustrationType="sapIllus-SignOut"
                    illustrationSize="Scene">
                </IllustratedMessage>
                <Button
                    text="{i18n>loginAgain}"
                    type="Emphasized"
                    press=".onLoginAgain"
                    class="sapUiSmallMarginTop" />
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>