<mvc:View controllerName="kms.controller.groups.Detail" xmlns:f="sap.f"
    xmlns:m="sap.m" xmlns="sap.uxap" xmlns:core="sap.ui.core"
    core:require="{ formatMessage: 'sap/base/strings/formatMessage', commonFormatter: 'kms/common/Formatters' }"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:layout="sap.ui.layout"
    xmlns:forms="sap.ui.layout.form">
    <ObjectPageLayout showTitleInHeaderContent="true" upperCaseAnchorBar="false">
        <headerTitle>
            <ObjectPageDynamicHeaderTitle>
                <expandedHeading>
                    <m:Title text="{oneWay>/groupData/name}" wrapping="true">
                        <m:customData>
                            <core:CustomData
                                key="testId"
                                value="groupDetail-mainTitle"
                                writeToDom="true" />
                        </m:customData>
                    </m:Title>
                </expandedHeading>
                <navigationActions>
                    <m:OverflowToolbarButton type="Transparent" icon="sap-icon://decline"
                        press="onCancel" tooltip="Close">
                        <m:customData>
                            <core:CustomData
                                key="testId"
                                value="groupDetail-closeButton"
                                writeToDom="true" />
                        </m:customData>
                    </m:OverflowToolbarButton>
                </navigationActions>
            </ObjectPageDynamicHeaderTitle>
        </headerTitle>

        <sections>
            <ObjectPageSection titleUppercase="false"
                title="{i18n>details}" showTitle="false">
                <subSections>
                    <ObjectPageSubSection>
                        <m:VBox>
                            <forms:Form width="100%">
                                <forms:layout>
                                    <forms:ColumnLayout
                                        columnsM="1" />
                                </forms:layout>
                                <forms:toolbar>
                                    <m:OverflowToolbar>
                                        <m:Title text="{i18n>details}">
                                            <m:customData>
                                                <core:CustomData
                                                    key="testId"
                                                    value="groupDetail-detailsTitle"
                                                    writeToDom="true" />
                                            </m:customData>
                                        </m:Title>
                                        <m:ToolbarSpacer />
                                        <m:Button icon="sap-icon://edit" text="{i18n>edit}"
                                            type="Ghost"
                                            visible="{= !${oneWay>/editMode} &amp;&amp; ${roleBasedAccess>/userGroups/canManage} }"
                                            enabled="{parts: ['oneWay>/groupData/name'], formatter: 'commonFormatter.isGroupEditEnabled'}"
                                            tooltip="{parts: ['oneWay>/groupData/name'], formatter: 'commonFormatter.autogeneratedGroupTooltip'}"
                                            press="onGroupEditDetailsPress">
                                            <m:customData>
                                                <core:CustomData
                                                    key="testId"
                                                    value="groupDetail-editButton"
                                                    writeToDom="true" />
                                            </m:customData>
                                        </m:Button>
                                        <m:Button icon="sap-icon://save" text="{i18n>save}"
                                            visible="{= !!${oneWay>/editMode}}"
                                            type="Emphasized"
                                            enabled="{oneWay>/groupValid}"
                                            press="onGroupSavePress">
                                            <m:customData>
                                                <core:CustomData
                                                    key="testId"
                                                    value="groupDetail-saveButton"
                                                    writeToDom="true" />
                                            </m:customData>
                                        </m:Button>
                                        <m:Button text="{i18n>cancel}"
                                            class="sapUiTinyMarginBegin"
                                            visible="{= !!${oneWay>/editMode}}"
                                            press="onGroupCancelPress">
                                            <m:customData>
                                                <core:CustomData
                                                    key="testId"
                                                    value="groupDetail-cancelButton"
                                                    writeToDom="true" />
                                            </m:customData>
                                        </m:Button>
                                    </m:OverflowToolbar>
                                </forms:toolbar>
                                <forms:formContainers>
                                    <forms:FormContainer visible="{= !${oneWay>/editMode} }">
                                        <forms:formElements>
                                            <forms:FormElement label="{i18n>name}">
                                                <forms:label>
                                                    <m:Label text="{i18n>name}">
                                                        <m:customData>
                                                            <core:CustomData
                                                                key="testId"
                                                                value="groupDetail-nameLabel"
                                                                writeToDom="true" />
                                                        </m:customData>
                                                    </m:Label>
                                                </forms:label>
                                                <forms:fields>
                                                    <m:Text text="{oneWay>/groupData/name}">
                                                        <m:customData>
                                                            <core:CustomData
                                                                key="testId"
                                                                value="groupDetail-nameText"
                                                                writeToDom="true" />
                                                        </m:customData>
                                                    </m:Text>
                                                </forms:fields>
                                            </forms:FormElement>
                                            <forms:FormElement label="{i18n>uuid}">
                                                <forms:label>
                                                    <m:Label text="{i18n>uuid}">
                                                        <m:customData>
                                                            <core:CustomData
                                                                key="testId"
                                                                value="groupDetail-uuidLabel"
                                                                writeToDom="true" />
                                                        </m:customData>
                                                    </m:Label>
                                                </forms:label>
                                                <forms:fields>
                                                    <m:Text text="{oneWay>/groupData/id}">
                                                        <m:customData>
                                                            <core:CustomData
                                                                key="testId"
                                                                value="groupDetail-uuidText"
                                                                writeToDom="true" />
                                                        </m:customData>
                                                    </m:Text>
                                                </forms:fields>
                                            </forms:FormElement>
                                            <forms:FormElement label="{i18n>description}">
                                                <forms:label>
                                                    <m:Label text="{i18n>description}">
                                                        <m:customData>
                                                            <core:CustomData
                                                                key="testId"
                                                                value="groupDetail-descriptionLabel"
                                                                writeToDom="true" />
                                                        </m:customData>
                                                    </m:Label>
                                                </forms:label>
                                                <forms:fields>
                                                    <m:Text text="{oneWay>/groupData/description}">
                                                        <m:customData>
                                                            <core:CustomData
                                                                key="testId"
                                                                value="groupDetail-descriptionText"
                                                                writeToDom="true" />
                                                        </m:customData>
                                                    </m:Text>
                                                </forms:fields>
                                            </forms:FormElement>
                                            <forms:FormElement label="{i18n>systemsRole}">
                                                <forms:label>
                                                    <m:Label text="{i18n>systemsRole}">
                                                        <m:customData>
                                                            <core:CustomData
                                                                key="testId"
                                                                value="groupDetail-roleLabel"
                                                                writeToDom="true" />
                                                        </m:customData>
                                                    </m:Label>
                                                </forms:label>
                                                <forms:fields>
                                                    <m:Text
                                                        text="{parts: ['oneWay>/groupData/role'], formatter: 'commonFormatter.setGroupRole'}">
                                                        <m:customData>
                                                            <core:CustomData
                                                                key="testId"
                                                                value="groupDetail-roleText"
                                                                writeToDom="true" />
                                                        </m:customData>
                                                    </m:Text>
                                                </forms:fields>
                                            </forms:FormElement>
                                            <forms:FormElement label="{i18n>iamId}">
                                                <forms:label>
                                                    <m:Label text="{i18n>iamId}">
                                                        <m:customData>
                                                            <core:CustomData
                                                                key="testId"
                                                                value="groupDetail-iamIdLabel"
                                                                writeToDom="true" />
                                                        </m:customData>
                                                    </m:Label>
                                                </forms:label>
                                                <forms:fields>
                                                    <m:Text text="{oneWay>/groupData/iamIdentifier}">
                                                        <m:customData>
                                                            <core:CustomData
                                                                key="testId"
                                                                value="groupDetail-iamIdText"
                                                                writeToDom="true" />
                                                        </m:customData>
                                                    </m:Text>
                                                </forms:fields>
                                            </forms:FormElement>
                                            <forms:FormElement label="{i18n>groupIAMStatus}">
                                                <forms:label>
                                                    <m:Label text="{i18n>groupIAMStatus}">
                                                        <m:customData>
                                                            <core:CustomData
                                                                key="testId"
                                                                value="groupDetail-iamSyncedLabel"
                                                                writeToDom="true" />
                                                        </m:customData>
                                                    </m:Label>
                                                </forms:label>
                                                <forms:fields>
                                                    <m:Text text="{= ${oneWay>/groupData/groupInIAM} ? ${i18n>yes} : ${i18n>no} }">
                                                        <m:customData>
                                                            <core:CustomData
                                                                key="testId"
                                                                value="groupDetail-iamSyncedText"
                                                                writeToDom="true" />
                                                        </m:customData>
                                                    </m:Text>
                                                </forms:fields>
                                            </forms:FormElement>
                                        </forms:formElements>
                                    </forms:FormContainer>

                                    <forms:FormContainer visible="{= !!${oneWay>/editMode} }">
                                        <forms:formElements>
                                            <forms:FormElement label="{i18n>name}">
                                                <forms:fields>
                                                    <m:Input value="{oneWay>/groupData/name}"
                                                        liveChange="onGroupNameChanged"
                                                        valueLiveUpdate="true"
                                                        valueState="{oneWay>/groupNameValueState}"
                                                        valueStateText="{oneWay>/groupNameValueStateText}" />
                                                </forms:fields>
                                            </forms:FormElement>
                                            <forms:FormElement label="{i18n>uuid}">
                                                <forms:fields>
                                                    <m:Text text="{oneWay>/groupData/id}" />
                                                </forms:fields>
                                            </forms:FormElement>
                                            <forms:FormElement label="{i18n>description}">
                                                <forms:fields>
                                                    <m:TextArea
                                                        value="{oneWay>/groupData/description}"
                                                        rows="4"
                                                        liveChange="onGroupDescriptionChanged"
                                                        width="100%" />
                                                </forms:fields>
                                            </forms:FormElement>
                                            <forms:FormElement label="{i18n>systemsRole}">
                                                <forms:fields>
                                                    <m:Text
                                                        text="{parts: ['oneWay>/groupData/role'], formatter: 'commonFormatter.setGroupRole'}" />
                                                </forms:fields>
                                            </forms:FormElement>
                                            <forms:FormElement label="{i18n>iamId}">
                                                <forms:fields>
                                                    <m:Input value="{oneWay>/groupData/iamIdentifier}"
                                                        liveChange="onGroupIamIdentifierChanged"
                                                        valueLiveUpdate="true"
                                                        valueState="{oneWay>/iamIdentifierValueState}"
                                                        valueStateText="{oneWay>/iamIdentifierValueStateText}">
                                                        <m:customData>
                                                            <core:CustomData
                                                                key="testId"
                                                                value="groupDetail-iamIdentifierInput"
                                                                writeToDom="true" />
                                                        </m:customData>
                                                    </m:Input>
                                                </forms:fields>
                                            </forms:FormElement>
                                            <forms:FormElement label="{i18n>groupIAMStatus}">
                                                <forms:fields>
                                                    <m:Text text="{= ${oneWay>/groupData/groupInIAM} ? ${i18n>yes} : ${i18n>no} }" />
                                                </forms:fields>
                                            </forms:FormElement>
                                        </forms:formElements>
                                    </forms:FormContainer>
                                </forms:formContainers>
                            </forms:Form>
                        </m:VBox>
                    </ObjectPageSubSection>
                </subSections>
            </ObjectPageSection>
        </sections>
    </ObjectPageLayout>
</mvc:View>