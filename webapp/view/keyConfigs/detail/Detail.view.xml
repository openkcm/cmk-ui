<mvc:View
    controllerName="kms.controller.keyConfigs.detail.Detail"
    xmlns="sap.uxap"
    xmlns:layout="sap.ui.layout"
    xmlns:m="sap.m"
    xmlns:tnt="sap.tnt"
    xmlns:forms="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    core:require="{ formatMessage: 'sap/base/strings/formatMessage' }">
    <ObjectPageLayout>
        <headerTitle>
            <ObjectPageDynamicHeaderTitle>
                <breadcrumbs>
                    <m:Breadcrumbs currentLocationText="{oneWay>/keyConfig/name}">
                        <m:Link text="{i18n>sideContentHome}"
                            href="#/home" />
                        <m:Link text="{i18n>sideContentKeyConfiguration}"
                            href="#/keyConfigs" />
                    </m:Breadcrumbs>
                </breadcrumbs>
                <expandedHeading>
                    <m:Title text="{oneWay>/keyConfig/name}" />
                </expandedHeading>
                <snappedHeading>
                    <m:Title text="{oneWay>/keyConfig/name}" />
                </snappedHeading>
                <expandedContent>
                    <m:Label text="{oneWay>/keyConfig/id}" />
                </expandedContent>
                <actions>
                    <m:Button
                        icon="sap-icon://refresh"
                        type="Transparent"
                        press="setKeyConfigData" />
                </actions>
            </ObjectPageDynamicHeaderTitle>
        </headerTitle>
        <sections>
            <ObjectPageSection titleUppercase="false" id="detailsObjectPageSection"
                title="{i18n>details}">
                <subSections>
                    <ObjectPageSubSection>
                        <m:VBox visible="{= !${oneWay>/edit}}">
                            <core:Fragment
                                fragmentName="kms.resources.fragments.keyConfigs.DetailsForm"
                                type="XML" />
                        </m:VBox>

                        <m:VBox visible="{= !!${oneWay>/edit}}">
                            <core:Fragment
                                fragmentName="kms.resources.fragments.keyConfigs.DetailsFormEditable"
                                type="XML" />
                        </m:VBox>
                    </ObjectPageSubSection>
                </subSections>
            </ObjectPageSection>
            <ObjectPageSection titleUppercase="false" id="keysObjectPageSection" title="{i18n>keys}"
                showTitle="false">
                <subSections>
                    <ObjectPageSubSection>
                        <m:VBox>
                            <m:VBox visible="{= ${oneWay>/keyConfig/keys}.length > 0 }">
                                <core:Fragment
                                    fragmentName="kms.resources.fragments.keys.KeysTable"
                                    type="XML" />
                            </m:VBox>
                            <m:VBox visible="{= ${oneWay>/keyConfig/keys}.length === 0 }">
                                <core:Fragment
                                    fragmentName="kms.resources.fragments.keys.NoKeysIllustration"
                                    type="XML" />
                            </m:VBox>
                        </m:VBox>
                    </ObjectPageSubSection>
                </subSections>
            </ObjectPageSection>
            <ObjectPageSection titleUppercase="false" id="systemsObjectPageSection"
                title="{i18n>connectedSystems}" showTitle="false">
                <subSections>
                    <ObjectPageSubSection>
                        <!-- @TODO Will be replaced by the proper systems table once that's done -->
                    </ObjectPageSubSection>
                </subSections>
            </ObjectPageSection>
        </sections>
    </ObjectPageLayout>
</mvc:View>