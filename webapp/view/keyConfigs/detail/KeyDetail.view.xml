<mvc:View
    controllerName="kms.controller.keyConfigs.detail.KeyDetail"
    xmlns="sap.uxap"
    xmlns:layout="sap.ui.layout"
    xmlns:m="sap.m"
    xmlns:tnt="sap.tnt"
    xmlns:forms="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:dataHelp="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    core:require="{ formatMessage: 'sap/base/strings/formatMessage' }">
    <ObjectPageLayout>
        <headerTitle>
            <ObjectPageDynamicHeaderTitle>
                <expandedHeading>
                    <m:Title text="{oneWay>/selectedKey/name}" />
                </expandedHeading>
                <snappedHeading>
                    <m:Title text="{oneWay>/selectedKey/name}" />
                </snappedHeading>
                <expandedContent>
                    <m:VBox>
                        <m:Label
                            text="{oneWay>/selectedKey/provider} • {oneWay>/selectedKey/region}" />
                        <m:HBox justifyContent="Start" alignContent="Center" alignItems="Center">
                            <m:Label text="{oneWay>/selectedKey/id}" />
                            <m:Button icon="sap-icon://copy" type="Transparent"
                                class="sapUiTinyMarginBegin sapUiTinyMarginBottom"
                                dataHelp:textToCopy="{oneWay>/selectedKey/id}"
                                press="onCopyToClipboardPress" />
                        </m:HBox>
                    </m:VBox>
                </expandedContent>
                <actions>
                    <m:Button icon="sap-icon://refresh"
                        type="Transparent"
                        press="getKeyDetails" />
                    <m:Button
                        icon="sap-icon://decline"
                        type="Transparent"
                        press="onKeyDetailsClosePress" />
                </actions>
            </ObjectPageDynamicHeaderTitle>
        </headerTitle>
        <sections>
            <ObjectPageSection titleUppercase="false" id="keyDetailsObjectPageSectionDetails"
                title="{i18n>details}" showTitle="false">
                <subSections>
                    <ObjectPageSubSection>
                        <m:VBox visible="{= !${oneWay>/edit}}">
                            <core:Fragment
                                fragmentName="kms.resources.fragments.keys.DetailsForm"
                                type="XML" />
                        </m:VBox>

                        <m:VBox visible="{= !!${oneWay>/edit}}">
                            <core:Fragment
                                fragmentName="kms.resources.fragments.keys.DetailsFormEditable"
                                type="XML" />
                        </m:VBox>
                    </ObjectPageSubSection>
                </subSections>
            </ObjectPageSection>
            <ObjectPageSection titleUppercase="false" id="keyDetailsObjectPageSectionVersions"
                title="{i18n>versions}"
                showTitle="false">
                <subSections>
                    <ObjectPageSubSection>
                        <m:VBox>
                            <core:Fragment
                                fragmentName="kms.resources.fragments.keys.VersionsTable"
                                type="XML" />
                        </m:VBox>
                    </ObjectPageSubSection>
                </subSections>
            </ObjectPageSection>
        </sections>
    </ObjectPageLayout>
</mvc:View>