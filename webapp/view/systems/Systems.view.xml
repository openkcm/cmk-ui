<mvc:View
    controllerName="kms.controller.systems.Systems"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:core="sap.ui.core"
    xmlns:m="sap.m"
    xmlns:f="sap.f"
    xmlns:kms="kms.control"
    core:require="{ formatMessage: 'sap/base/strings/formatMessage' }"
    xmlns:mvc="sap.ui.core.mvc">
    <f:DynamicPage>
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>sideContentSystems}" />
                </f:heading>
                <f:snappedTitleOnMobile>
                    <Title text="{i18n>sideContentSystems}" />
                </f:snappedTitleOnMobile>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader>
                <f:content>
                    <kms:FilterBar id="systemsFilterBar" search="getSystems"
                        reset="onReset">
                        <kms:FilterBarItem label="{i18n>region}">
                            <MultiComboBox
                                name="{i18n>region}"
                                selectionChange=".onSelectionChange"
                                placeholder="{i18n>all}"
                                items="{oneWay>/systems}">
                                <core:Item key="{oneWay>region}" text="{oneWay>region}" />
                                <customData>
                                    <core:CustomData
                                        key="testId"
                                        value="systemsFilterBar-regionComboBox"
                                        writeToDom="true" />
                                </customData>
                            </MultiComboBox>
                        </kms:FilterBarItem>
                        <kms:FilterBarItem label="{i18n>sid}">
                            <MultiComboBox
                                placeholder="{i18n>all}"
                                name="{i18n>sid}"
                                items="{oneWay>/systems}">
                                <core:Item key="{oneWay>sid}" text="{oneWay>sid}" />
                                <customData>
                                    <core:CustomData
                                        key="testId"
                                        value="systemsFilterBar-sidComboBox"
                                        writeToDom="true" />
                                </customData>
                            </MultiComboBox>
                        </kms:FilterBarItem>

                        <kms:FilterBarItem label="{i18n>systemsRole}">
                            <MultiComboBox
                                placeholder="{i18n>all}"
                                name="{i18n>systemsRole}"
                                selectionChange=".onSelectionChange"
                                items="{oneWay>/systems}">
                                <core:Item key="{oneWay>systemRole}"
                                    text="{oneWay>systemRole}" />
                                <customData>
                                    <core:CustomData
                                        key="testId"
                                        value="systemsFilterBar-systemsRoleComboBox"
                                        writeToDom="true" />
                                </customData>
                            </MultiComboBox>
                        </kms:FilterBarItem>
                        <kms:FilterBarItem label="{i18n>keyConfiguration}">

                            <MultiComboBox
                                placeholder="{i18n>all}"
                                name="{i18n>keyConfiguration}"
                                selectionChange=".onSelectionChange"
                                items="{oneWay>/systems}">
                                <core:Item key="{oneWay>keyConfig}"
                                    text="{oneWay>keyConfig}" />
                                <customData>
                                    <core:CustomData
                                        key="testId"
                                        value="systemsFilterBar-keyConfigComboBox"
                                        writeToDom="true" />
                                </customData>
                            </MultiComboBox>
                        </kms:FilterBarItem>
                    </kms:FilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <m:VBox>
                <Panel visible="{= ${oneWay>/systems}.length > 0 }">
                    <m:VBox>
                        <core:Fragment
                            fragmentName="kms.resources.fragments.systems.SystemsTable"
                            type="XML" />
                        <kms:Pagination
                            currentPage="{pagination>/currentPage}"
                            totalPages="{pagination>/totalPages}"
                            onPreviousPage="onPreviousPage"
                            onNextPage="onNextPage" />
                    </m:VBox>
                </Panel>
                <m:VBox visible="{= ${oneWay>/systems}.length === 0 }">
                    <core:Fragment
                        fragmentName="kms.resources.fragments.common.NoDataTableIllustration"
                        type="XML" />
                </m:VBox>
            </m:VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>