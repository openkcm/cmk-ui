<mvc:View
    controllerName="kms.controller.systems.Systems"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core"
    xmlns:m="sap.m"
    xmlns:f="sap.f"
    core:require="{ formatMessage: 'sap/base/strings/formatMessage' }"
    xmlns:mvc="sap.ui.core.mvc">
    <f:DynamicPage>
        <f:title>
            <f:DynamicPageTitle>
                <f:breadcrumbs>
                    <Breadcrumbs currentLocationText="{i18n>sideContentSystems}">
                        <Link text="{i18n>sideContentHome}"
                            href="#/home" />
                    </Breadcrumbs>
                </f:breadcrumbs>
                <f:heading>
                    <Title text="{i18n>sideContentSystems}" />
                </f:heading>
                <f:snappedTitleOnMobile>
                    <Title text="{i18n>sideContentSystems}" />
                </f:snappedTitleOnMobile>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader>
                <f:content>
                    <fb:FilterBar id="filterbar" persistencyKey="myPersKey" useToolbar="false"
                        search=".onSearch" filterChange=".onFilterChange"
                        afterVariantLoad=".onAfterVariantLoad">
                        <fb:filterGroupItems>
                            <fb:FilterGroupItem name="Region" label="{i18n>region}" groupName="Group1"
                                visibleInFilterBar="true">
                                <fb:control>
                                    <MultiComboBox
                                        name="{i18n>region}"
                                        selectionChange=".onSelectionChange"
                                        placeholder="{i18n>all}"
                                        items="{oneWay>/systems}"
                                    >
                                        <core:Item key="{oneWay>region}" text="{oneWay>region}" />
                                    </MultiComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem name="SID" label="{i18n>sid}" groupName="Group1"
                                visibleInFilterBar="true">
                                <fb:control>
                                    <MultiComboBox
                                        placeholder="{i18n>all}"
                                        name="{i18n>sid}"
                                        items="{oneWay>/systems}"
                                    >
                                        <core:Item key="{oneWay>sid}" text="{oneWay>sid}" />
                                    </MultiComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem name="System Role" label="{i18n>systemsRole}"
                                groupName="Group1" visibleInFilterBar="true">
                                <fb:control>
                                    <MultiComboBox
                                        placeholder="{i18n>all}"
                                        name="{i18n>systemsRole}"
                                        selectionChange=".onSelectionChange"
                                        items="{oneWay>/systems}"
                                    >
                                        <core:Item key="{oneWay>systemRole}"
                                            text="{oneWay>systemRole}" />
                                    </MultiComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem name="Application Role" label="{i18n>applicationRole}"
                                groupName="Group1" visibleInFilterBar="true">
                                <fb:control>
                                    <MultiComboBox
                                        placeholder="{i18n>all}"
                                        name="{i18n>applicationRole}"
                                        selectionChange=".onSelectionChange"
                                        items="{oneWay>/systems}"
                                    >
                                        <core:Item key="{oneWay>applicationRole}"
                                            text="{oneWay>applicationRole}" />
                                    </MultiComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem name="Key Configuration" label="{i18n>keyConfiguration}"
                                groupName="Group1" visibleInFilterBar="true">
                                <fb:control>
                                    <MultiComboBox
                                        placeholder="{i18n>all}"
                                        name="{i18n>keyConfiguration}"
                                        selectionChange=".onSelectionChange"
                                        items="{oneWay>/systems}"
                                    >
                                        <core:Item key="{oneWay>keyConfig}"
                                            text="{oneWay>keyConfig}" />
                                    </MultiComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>
                        </fb:filterGroupItems>
                    </fb:FilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <core:Fragment
                fragmentName="kms.resources.fragments.SystemsTable"
                type="XML" />
        </f:content>
    </f:DynamicPage>
</mvc:View>