<mvc:View
    controllerName="kms.controller.users.Users"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    core:require="{ formatMessage: 'sap/base/strings/formatMessage' }">
    <f:DynamicPage>
        <f:title>
            <f:DynamicPageTitle>
                <f:breadcrumbs>
                    <Breadcrumbs currentLocationText="{i18n>sideContentUserManagement}">
                        <Link text="{i18n>sideContentHome}"
                            href="#/home" />
                    </Breadcrumbs>
                </f:breadcrumbs>
                <f:heading>
                    <Title text="{i18n>sideContentUserManagement}" />
                </f:heading>
                <f:snappedTitleOnMobile>
                    <Title text="{i18n>sideContentUserManagement}" />
                </f:snappedTitleOnMobile>
                <f:actions>
                    <Button
                        icon="sap-icon://refresh"
                        type="Transparent"
                        press="setGroups" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <VBox>
                <Panel visible="{= ${oneWay>/groupsCount} > 0 }">
                    <VBox>
                        <core:Fragment
                            fragmentName="kms.resources.fragments.users.UserGroupsTable"
                            type="XML" />
                    </VBox>
                </Panel>
                <VBox visible="{= ${oneWay>/groupsCount} === 0 }">
                    <core:Fragment
                        fragmentName="kms.resources.fragments.users.NoUserGroupsIllustration"
                        type="XML" />
                </VBox>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>